        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "web+oilcalc",
      "url": "./?protocol=%s"
    }
  ],
  "share_target": {
    "action": "./?share",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "widgets": [
    {
      "name": "油品密度与体积换算快捷工具",
      "short_name": "油品快捷",
      "description": "提供极简版的油品密度及体积即时换算卡片。",
